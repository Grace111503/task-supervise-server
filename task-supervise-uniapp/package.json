    "upload": "node scripts/mini-ci.js upload",
    "type-check": "vue-tsc --noEmit",
    "analyze": "cross-env ANALYZE=true uni build -p mp-weixin",
    "up": "pnpm dlx taze major --exclude /@dcloudio/ -wir && pnpm dlx @dcloudio/uvm@latest",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "clean": "rimraf dist node_modules/.vite",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:pre": "node scripts/release.js prerelease",
    "changelog": "pnpm exec changelogen",
    "syn_rpo": "pnpm dlx template-syncer --repo https://github.com/IceyWu/uniapp-starter.git --branch main",
    "skills:add": "node scripts/skills-add.js",
    "prepare": "lefthook install"
  },
