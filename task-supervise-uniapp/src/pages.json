{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "globalStyle": {
    "app-plus": {
      "bounce": "none",
      "titleNView": false
    },
    "backgroundColor": "@bgColor",
    "backgroundColorBottom": "@bgColorBottom",
    "backgroundColorTop": "@bgColorTop",
    "backgroundTextStyle": "@bgTxtStyle",
    "disableScroll": true,
    "enablePullDownRefresh": false,
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "task-supervise",
    "navigationStyle": "custom"
  },
  "pages": [
    // #ifdef H5 || MP-WEIXIN
    {
      "path": "pages/home/index",
      "layout": "home"
    },
    // #endif
    {
      "path": "pages/feedback/list",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "反馈记录"
      }
    },
    {
      "path": "pages/feedback/submit",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "提交反馈"
      }
    },
    {
      "path": "pages/home/detail",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "任务详情"
      }
    },
    {
      "path": "pages/home/edit",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "编辑任务"
      }
    },
    {
      "path": "pages/home/overdue-detail",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "逾期处置"
      }
    },
    {
      "path": "pages/home/overdue",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "逾期任务管理"
      }
    },
    {
      "path": "pages/login/index",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/login/register",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "注册"
      }
    },
    {
      "path": "pages/message/index",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "消息中心"
      }
    },
    {
      "path": "pages/mine/about",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "关于我们"
      }
    },
    {
      "path": "pages/mine/index",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/mine/profile",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "个人信息"
      }
    }
  ],
  "subPackages": [],
  "tabBar": {
    "color": "#86909c",
    "custom": true,
    "selectedColor": "#07C160",
    "list": [
      // GENERATED BY UNI-PAGES, PLATFORM: H5 || MP-WEIXIN
      {
        "iconPath": "static/tabbar/placeholder.png",
        "pagePath": "pages/home/index",
        "selectedIconPath": "static/tabbar/placeholder.png",
        "text": "首页"
      },
      {
        "iconPath": "static/tabbar/placeholder.png",
        "pagePath": "pages/mine/index",
        "selectedIconPath": "static/tabbar/placeholder.png",
        "text": "我的"
      }
    ]
  }
}
